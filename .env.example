# ==============================================================================
# VARIABLES DE ENTORNO UNIFICADAS - ECODELIVERY DATA PLATFORM (PLANTILLA)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. POSTGRESQL (STORAGE & DATA WAREHOUSE)
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ecodelivery_user
POSTGRES_PASSWORD=tu_password_segura
POSTGRES_DB=ecodelivery_db

# Base de metadatos de Airflow
AIRFLOW_DB_NAME=airflow_db

# Base de datos para el Data Warehouse (Capas: bronze, silver, gold)
DWH_DB_NAME=ecodelivery_dwh

# URIs de conexión interna para las tareas del Pipeline (Airflow -> DBs)
AIRFLOW_OLTP_URI=postgresql+psycopg2://ecodelivery_user:tu_password_segura@postgres:5432/ecodelivery_db
AIRFLOW_DWH_URI=postgresql+psycopg2://ecodelivery_user:tu_password_segura@postgres:5432/ecodelivery_dwh

# ------------------------------------------------------------------------------
# 2. APACHE AIRFLOW 3.0 (ORCHESTRATION & PIPELINES)
# ------------------------------------------------------------------------------
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://ecodelivery_user:tu_password_segura@postgres:5432/airflow_db
AIRFLOW__CORE__FERNET_KEY=tu_fernet_key_generada_aqui
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__ENABLE_XCOM_PICKLING=True
AIRFLOW__WEBSERVER__SECRET_KEY=tu_webserver_secret_key_generada
AIRFLOW__API_AUTH__JWT_SECRET=tu_jwt_secret_key_generada

# Credenciales iniciales del Administrador de Airflow
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
AIRFLOW_ADMIN_PASSWORD=admin

# ------------------------------------------------------------------------------
# 3. BACKEND FASTAPI (SEGURIDAD & JWT)
# ------------------------------------------------------------------------------
SECRET_KEY="tu_clave_secreta_jwt_aqui_generar_con_openssl"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 4. CREDENCIALES OAUTH (GOOGLE & GITHUB)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="tu_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"

GITHUB_CLIENT_ID="tu_github_client_id"
GITHUB_CLIENT_SECRET="tu_github_client_secret"
GITHUB_REDIRECT_URI="http://localhost:8000/api/v1/auth/github/callback"
