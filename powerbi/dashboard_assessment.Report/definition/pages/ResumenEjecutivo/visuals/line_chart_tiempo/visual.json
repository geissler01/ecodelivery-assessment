{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.12.0/schema.json",
  "name": "line_chart_tiempo",
  "position": {
    "x": 650,
    "y": 170,
    "z": 2000,
    "height": 380,
    "width": 600
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_date"
                    }
                  },
                  "Property": "month_name"
                }
              },
              "queryRef": "dim_date.month_name",
              "nativeQueryRef": "Mes",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_pedidos"
                    }
                  },
                  "Property": "Total Pedidos"
                }
              },
              "queryRef": "fact_pedidos.Total Pedidos",
              "nativeQueryRef": "Total Pedidos"
            }
          ]
        }
      }
    }
  }
}