              "nativeQueryRef": "Tipo de Vehiculo"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_pedidos"
                    }
                  },
                  "Property": "Total Pedidos"
                }
              },
              "queryRef": "fact_pedidos.Total Pedidos",
              "nativeQueryRef": "Volumen"
            }
          ]
        }
      }
    }
