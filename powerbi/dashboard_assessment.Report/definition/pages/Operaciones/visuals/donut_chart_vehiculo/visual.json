{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.1.0/schema.json",
  "name": "donut_chart_vehiculo",
  "position": {
    "x": 650,
    "y": 170,
    "width": 600,
    "height": 380,
    "z": 2000
  },
  "visual": {
    "visualType": "donutChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
