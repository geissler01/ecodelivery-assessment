{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.1.0/schema.json",
  "name": "bar_chart_sla_zona",
  "position": {
    "x": 30,
    "y": 170,
    "width": 590,
    "height": 380,
    "z": 2000
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_zona"
                    }
                  },
                  "Property": "nombre_zona"
                }
              },
              "queryRef": "dim_zona.nombre_zona",
              "nativeQueryRef": "Zona"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_pedidos"
                    }
                  },
                  "Property": "Tiempo Promedio Entrega (min)"
                }
              },
              "queryRef": "fact_pedidos.Tiempo Promedio Entrega (min)",
              "nativeQueryRef": "SLA Minutos"
            }
          ]
        }
      }
    }
  }
}
