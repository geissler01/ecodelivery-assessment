              ]
            },
            "Y": {
              "projections": [
                {
                  "field": { "Measure": { "Expression": { "SourceRef": { "Entity": "fact_pedidos" } }, "Property": "Total Pedidos" } },
                  "queryRef": "fact_pedidos.Total Pedidos"
                },
                {
                  "field": { "Measure": { "Expression": { "SourceRef": { "Entity": "fact_pedidos" } }, "Property": "Pedidos Entregados" } },
                  "queryRef": "fact_pedidos.Pedidos Entregados"
                }
              ]
            }
          }
        },
        "title": { "text": "Pedidos por Zona (Total vs Entregados)", "visible": true }
      }
