                {
                  "field": { "Measure": { "Expression": { "SourceRef": { "Entity": "fact_pedidos" } }, "Property": "Costos Totales" } },
                  "queryRef": "fact_pedidos.Costos Totales"
                },
                {
                  "field": { "Measure": { "Expression": { "SourceRef": { "Entity": "fact_pedidos" } }, "Property": "Margen Bruto Total" } },
                  "queryRef": "fact_pedidos.Margen Bruto Total"
                }
              ]
            }
          }
        },
