      "visual": {
        "visualType": "lineChart",
        "query": {
          "queryState": {
            "Category": {
              "projections": [
                {
                  "field": { "Column": { "Expression": { "SourceRef": { "Entity": "dim_date" } }, "Property": "month_name" } },
