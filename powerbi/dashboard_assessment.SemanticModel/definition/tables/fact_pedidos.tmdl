		lineageTag: f1a2b3c4-0001-0001-0001-000000000011
		summarizeBy: none

	column id_pedido
		dataType: string
		sourceColumn: id_pedido
		lineageTag: f1a2b3c4-0001-0001-0001-000000000012
		summarizeBy: none

	column cliente_sk
		dataType: int64
		sourceColumn: cliente_sk
		lineageTag: f1a2b3c4-0001-0001-0001-000000000013
		summarizeBy: none

