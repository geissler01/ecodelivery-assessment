table fact_pedidos
	lineageTag: f1a2b3c4-0001-0001-0001-000000000001

	measure 'Total Pedidos' = COUNTROWS(fact_pedidos)
		formatString: #,0
		lineageTag: f1a2b3c4-0001-0001-0001-000000000051

	measure 'Pedidos Entregados' = CALCULATE(COUNTROWS(fact_pedidos), fact_pedidos[estado] = "entregado")
		formatString: #,0
		lineageTag: f1a2b3c4-0001-0001-0001-000000000052

	measure 'Tasa de Entrega %' = DIVIDE([Pedidos Entregados], [Total Pedidos], 0) * 100
		formatString: 0.0"%"
		lineageTag: f1a2b3c4-0001-0001-0001-000000000053

	measure 'Tiempo Promedio Entrega (min)' = CALCULATE(AVERAGE(fact_pedidos[tiempo_entrega_minutos]), fact_pedidos[estado] = "entregado")
		formatString: #,0.0
		lineageTag: f1a2b3c4-0001-0001-0001-000000000054

	measure 'Ingresos Totales' = SUM(fact_pedidos[monto])
		formatString: $ #,0.00
		lineageTag: f1a2b3c4-0001-0001-0001-000000000055

	measure 'Costos Totales' = SUM(fact_pedidos[costo_operacion])
		formatString: $ #,0.00
		lineageTag: f1a2b3c4-0001-0001-0001-000000000056

	measure 'Margen Bruto Total' = SUM(fact_pedidos[margen_bruto])
		formatString: $ #,0.00
		lineageTag: f1a2b3c4-0001-0001-0001-000000000057

	measure 'Margen %' = DIVIDE([Margen Bruto Total], [Ingresos Totales], 0) * 100
		formatString: 0.0"%"
		lineageTag: f1a2b3c4-0001-0001-0001-000000000058

	measure 'Ticket Promedio' = AVERAGE(fact_pedidos[monto])
		formatString: $ #,0.00
		lineageTag: f1a2b3c4-0001-0001-0001-000000000059

	measure 'Pedidos Fin de Semana' = CALCULATE(COUNTROWS(fact_pedidos), dim_date[is_weekend] = TRUE())
		formatString: #,0
		lineageTag: f1a2b3c4-0001-0001-0001-000000000060

	measure 'Pedidos No Entregados' = CALCULATE(COUNTROWS(fact_pedidos), fact_pedidos[estado] <> "entregado")
		formatString: #,0
		lineageTag: f1a2b3c4-0001-0001-0001-000000000061

